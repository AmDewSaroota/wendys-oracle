# ---- ล็อกอิน Google ----
AUTH_SECRET=            # สุ่มขึ้นมาเอง (openssl rand -base64 32)
AUTH_GOOGLE_ID=         # จาก Google Cloud Console
AUTH_GOOGLE_SECRET=     # จาก Google Cloud Console

# ใครเข้าได้บ้าง (เว้นว่างทั้งคู่ = ไม่มีใครเข้าได้เลย)
ALLOWED_EMAILS=         # คั่นด้วยจุลภาค เช่น a@x.com,b@y.com
ALLOWED_DOMAINS=        # คั่นด้วยจุลภาค เช่น fortal.studio

# ใครกดผ่าน/ตีกลับได้ (เว้นว่าง = ทุกคนที่เข้าได้)
REVIEWER_EMAILS=

# ---- ฐานข้อมูล (Neon Postgres ผ่าน Vercel Marketplace) ----
DATABASE_URL=
